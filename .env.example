# Copy this file to .env and fill in the real destinations.
# Only HTTPS URLs are accepted for external applications (http is allowed for localhost during development).
# Leave a value empty to show a "not configured" message instead of a broken link.

VITE_USER_MANAGEMENT_URL=
VITE_ASSET_MANAGEMENT_URL=
VITE_TISA_TEAMS_URL=

# Optional static availability labels: available | maintenance | coming-soon
# Leave empty to hide the indicator. These are configured labels, not live health checks.
VITE_USER_MANAGEMENT_STATUS=
VITE_ASSET_MANAGEMENT_STATUS=
VITE_TISA_TEAMS_STATUS=

# Optional branding overrides
VITE_BRAND_NAME=
VITE_BRAND_TAGLINE=

# Contact card for IT solution setup enquiries. Leave a value empty to hide that channel.
# If none are set, the card shows a "not configured" message instead of invented details.
VITE_CONTACT_NAME=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_URL=
VITE_CONTACT_URL_LABEL=
